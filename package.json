{
  "name": "veggiedent-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview -w apps/lp"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
