{
  "name": "@veggiedent/content-schema",
  "private": true,
  "version": "1.0.0",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "description": "Esquemas declarativos das secoes de conteudo da LP Veggiedent: fonte unica de validacao, formulario do painel e tipos.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js"
}
