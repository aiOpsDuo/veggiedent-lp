{
  "name": "@veggiedent/admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Painel de administracao do CMS Veggiedent, servido sob /admin.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --prefix ../../packages/content-schema",
