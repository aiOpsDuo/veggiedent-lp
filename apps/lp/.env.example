# Ver Especificacao Funcional v1.0, secao 8.6.

# URL publica de download do e-book. O "Guia Everyday Care" (entregue pela Virbac em
# 2026-10-05) e estatico da propria LP: apps/lp/public/materiais/. Vazio, o
# SuccessModal nao mostra botao de download (cai no modo 'email' abaixo).
VITE_EBOOK_URL=/materiais/guia-everyday-care-virbac.pdf

# 'download' | 'email' — controla o conteudo do SuccessModal apos o envio do formulario.
# Default se ausente: 'email' (nunca mostra um botao de download apontando para lugar nenhum).
VITE_EBOOK_DELIVERY_MODE=download

# Endpoint que recebe o formulario de captura. Relativo porque LP e API
# compartilham dominio. O lead e gravado no banco do CMS, que e o unico lugar
# onde ele existe — nao ha destino externo.
VITE_LEAD_SUBMIT_ENDPOINT=/api/leads

# De onde a LP le o conteudo publicado (SDD, D-08). Relativo porque LP e API
# compartilham dominio. Quando a busca falha, a pagina renderiza o instantaneo
# embutido no build (apps/lp/src/content/content-snapshot.json).
VITE_CONTENT_ENDPOINT=/api/content
