# Modelo do ambiente da API. Copie para apps/api/.env e preencha com os valores
# reais — o .env e gitignorado e nunca deve ser commitado.
#
# Estas variaveis sao do servidor. NUNCA as prefixe com VITE_: o Vite expoe
# qualquer VITE_* no bundle do navegador (SDD, risco R-09).
#
# A API valida este arquivo na inicializacao: faltando uma variavel obrigatoria
# ela recusa subir e nomeia a variavel, em vez de falhar em tempo de requisicao.

# --- Processo -------------------------------------------------------------
# Opcionais. NODE_ENV: development | test | production (padrao: development).
# PORT: porta HTTP da API (padrao: 3000).
NODE_ENV=development
PORT=3000

# --- Supabase (obrigatorias) ---------------------------------------------
# URL do projeto Supabase.
SUPABASE_URL=
# Chave secreta do Supabase. Ignora RLS — jamais no cliente.
SUPABASE_SECRET_KEY=
# Endpoint JWKS do projeto: as chaves PUBLICAS com que a API verifica o token
# dos operadores. Nao e segredo de assinatura — a API nao guarda nenhum.
# Normalmente <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# --- HTTP (obrigatoria) ---------------------------------------------------
# Origens autorizadas a chamar a API, separadas por virgula.
ALLOWED_ORIGINS=http://localhost:5173

# SUPABASE_PUBLISHABLE_KEY nao entra aqui: ela e do painel (VITE_SUPABASE_PUBLISHABLE_KEY)
# e do script supabase/scripts/verify-isolation.mjs, nao da API.
