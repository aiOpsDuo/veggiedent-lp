# Modelo do ambiente da API. Copie para apps/api/.env e preencha com os valores
# reais — o .env e gitignorado e nunca deve ser commitado.
#
# Estas variaveis sao do servidor. NUNCA as prefixe com VITE_: o Vite expoe
# qualquer VITE_* no bundle do navegador (SDD, risco R-09).
#
# A API valida este arquivo na inicializacao: faltando uma variavel obrigatoria
# ela recusa subir e nomeia a variavel, em vez de falhar em tempo de requisicao.

# --- Processo -------------------------------------------------------------
# Opcionais. NODE_ENV: development | test | production (padrao: development).
# PORT: porta HTTP da API (padrao: 3000).
NODE_ENV=development
PORT=3000

# --- MySQL (obrigatoria) ---------------------------------------------------
# Connection string do MySQL no formato que o Prisma espera:
# mysql://usuario:senha@host:porta/banco
DATABASE_URL=

# --- MinIO (obrigatorias) --------------------------------------------------
# Endereco do MinIO (compativel com S3), alcancado so pela API, nunca pelo
# navegador. Ex.: http://localhost:9000
MINIO_ENDPOINT=
# Endereco publico do MinIO — o que o navegador de fato alcanca (direto, ou
# atraves de um proxy, ver docker/nginx.conf § location /storage/ no ambiente
# Docker). Precisa ser diferente de MINIO_ENDPOINT sempre que o endereco acima
# nao for alcancavel de fora do processo da API — por exemplo, rodando sem
# Docker com o MinIO exposto localmente, os dois costumam ser identicos.
MINIO_PUBLIC_URL=
# Access key e secret key do MinIO. Segredos — jamais no cliente.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Nomes dos buckets de imagens e de videos.
MINIO_BUCKET_IMAGES=
MINIO_BUCKET_VIDEOS=

# --- Autenticacao (obrigatoria) --------------------------------------------
# Segredo simetrico de assinatura do JWT proprio da aplicacao (autenticacao
# sem provedor externo). Segredo — jamais no cliente. OBRIGATORIO gerar um
# valor novo por ambiente — nunca copie o de outro .env, nem reaproveite entre
# desenvolvimento e producao: quem tiver este valor consegue forjar a sessao
# de qualquer operador.
# Gere com, por exemplo:
#   openssl rand -base64 32
AUTH_JWT_SECRET=

# --- HTTP (obrigatoria) ---------------------------------------------------
# Origens autorizadas a chamar a API, separadas por virgula.
ALLOWED_ORIGINS=http://localhost:5173
