{
  "name": "@veggiedent/api",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "description": "API do CMS Veggiedent: conteudo, midia, metadados e leads.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "prebuild": "npm run build --prefix ../../packages/content-schema",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run build --prefix ../../packages/content-schema",
    "test": "jest",
    "pretest": "npm run build --prefix ../../packages/content-schema",
    "premigrate:content": "npm run build",
    "migrate:content": "node --env-file-if-exists=.env dist/migration/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@supabase/supabase-js": "^2.114.0",
    "@types/jsdom": "^21.1.7",
    "@veggiedent/content-schema": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jose": "^5.10.0",
    "jsdom": "^25.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
