# Variaveis de ambiente PRIVADAS da funcao serverless.
# NUNCA prefixar com VITE_ — isso as exporia publicamente no bundle do front-end.
# NUNCA commitar valores reais neste arquivo.

# Token de API do RD Station Marketing (gerado no painel do RD Station).
RDSTATION_API_TOKEN=

# Identificador do evento de conversao configurado no RD Station para esta LP
# (Conversão de API / "TAG" de identificação do evento).
RDSTATION_CONVERSION_IDENTIFIER=lp-veggiedent-ebook

# Origem(ns) autorizada(s) a chamar esta funcao (CORS). Separar por virgula se
# houver mais de uma (ex.: dominio de staging + dominio de producao).
ALLOWED_ORIGINS=https://p.virbac.com.br
